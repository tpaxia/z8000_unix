! int gtty(fd, buf) -- syscall #32
! ======================================================================
_gtty:
	ld	r1, 2(sp)	! fd
	ld	r2, 4(sp)	! buf
	sc	#32
	cp	r0, #0xFFFF
	jr eq,	cerror
	ret

! ======================================================================
! int access(name, mode) -- syscall #33
! ======================================================================
_access:
	ld	r1, 2(sp)	! name
	ld	r2, 4(sp)	! mode
	sc	#33
	cp	r0, #0xFFFF
	jr eq,	cerror
	ret

! ======================================================================
! int nice(incr) -- syscall #34
! ======================================================================
_nice:
	ld	r1, 2(sp)	! incr
	sc	#34
	ret

! ======================================================================
! sync(void) -- syscall #36
! ======================================================================
_sync:
	sc	#36
	ret

! ======================================================================
! int kill(pid, sig) -- syscall #37
! ======================================================================
_kill:
	ld	r1, 2(sp)	! pid
	ld	r2, 4(sp)	! sig
	sc	#37
	cp	r0, #0xFFFF
	jr eq,	cerror
	ret

! ======================================================================
! int dup(fd [, fd2]) -- syscall #41
! Two-arg form: dup(fd|0100, fd2) for dup2.
! ======================================================================
_dup:
	ld	r1, 2(sp)	! fd (possibly OR'd with 0100)
	ld	r2, 4(sp)	! fd2 (for dup2, ignored otherwise)
	sc	#41
	cp	r0, #0xFFFF
	jr eq,	cerror
	ret

! ======================================================================
! int pipe(fildes) -- syscall #42
! Kernel returns: R0=read_fd, R1=write_fd.
! Wrapper writes to fildes[0] and fildes[1].
! ======================================================================
_pipe:
	sc	#42
	cp	r0, #0xFFFF
	jr eq,	cerror
	ld	r2, 2(sp)	! fildes pointer
	ld	0(r2), r0	! fildes[0] = read fd
	ld	2(r2), r1	! fildes[1] = write fd
	ldk	r0, #0		! return 0 on success
	ret

! ======================================================================
! int times(buf) -- syscall #43
! ======================================================================
_times:
	ld	r1, 2(sp)	! buf
	sc	#43
	ret

! ======================================================================
! int setgid(gid) -- syscall #46
! ======================================================================
_setgid:
	ld	r1, 2(sp)	! gid
	sc	#46
	cp	r0, #0xFFFF
	jr eq,	cerror
	ret

! ======================================================================
! int getgid(void) -- syscall #47
! ======================================================================
_getgid:
	sc	#47
	ret

! ======================================================================
! int (*signal(sig, func))() -- syscall #48
! Sets signal handler, returns old handler.
! Kernel: R0 = old handler (or -1 on error).
! ======================================================================
_signal:
	push	@sp, r4
	push	@sp, r5
	ld	r1, 6(sp)	! sig
	ld	r2, 8(sp)	! func
	cp	r1, #17		! NSIG; reject before indexing the table
	jr uge,	.Lsigbad
	cp	r1, #0
	jr eq,	.Lsigbad
	ld	r5, r1
	add	r5, r5
	lda	r4, .Lsigvec
	add	r5, r4
	ld	r4, @r5		! old C handler, kept across the syscall
	ld	@r5, r2		! publish before kernel may deliver the signal
	cp	r2, #0
	jr eq,	.Lsigset
	bit	r2, #0
	jr ne,	.Lsigset	! odd dispositions mean ignore, as in V7
	lda	r2, .Lsigtramp
.Lsigset:
	sc	#48
	cp	r0, #0xFFFF
	jr eq,	.Lsigerr
	cp	r0, #0
	jr eq,	.Lsigdone
	bit	r0, #0
	jr ne,	.Lsigdone
	ld	r0, r4		! translate previous trampoline to C handler
.Lsigdone:
	pop	r5, @sp
	pop	r4, @sp
	ret
.Lsigerr:
	ld	@r5, r4		! failed registration must leave table intact
	jr	.Lsigfail
.Lsigbad:
	ld	r0, #0xFFFF
	ld	r1, #22		! EINVAL
.Lsigfail:
	pop	r5, @sp
	pop	r4, @sp
	jp	cerror

! Kernel entry frame: signo, saved FCW, saved R0, saved PC.
! No privileged signal-return instruction or syscall is needed.
.Lsigtramp:
	push	@sp, r1
	push	@sp, r2
	push	@sp, r3
	push	@sp, r4
	push	@sp, r5
	push	@sp, r6
	push	@sp, r7
	push	@sp, r8
	push	@sp, r9
	push	@sp, r10
	push	@sp, r11
	push	@sp, r12
	push	@sp, r13
	push	@sp, r14
	ld	r0, 28(sp)	! signo
	ld	r1, r0
	add	r1, r1
	lda	r2, .Lsigvec
	add	r2, r1
	ld	r2, @r2
	push	@sp, r0
	call	@r2
	add	sp, #2
	pop	r14, @sp
	pop	r13, @sp
	pop	r12, @sp
	pop	r11, @sp
	pop	r10, @sp
	pop	r9, @sp
	pop	r8, @sp
	pop	r7, @sp
	pop	r6, @sp
	pop	r5, @sp
	pop	r4, @sp
	pop	r3, @sp
	pop	r2, @sp
	pop	r1, @sp
	pop	r0, @sp		! discard signo
	pop	r0, @sp		! saved FCW
	ldctlb	flags, rl0	! restore only unprivileged condition flags
	pop	r0, @sp		! restore original R0 without changing flags
	ret			! restore PC and original SP
	.bss
.Lsigvec:
	.zerow	17
	.text

! ======================================================================
! int ioctl(fd, cmd, arg) -- syscall #54
! ======================================================================
_ioctl:
	ld	r1, 2(sp)	! fd
	ld	r2, 4(sp)	! cmd
	ld	r3, 6(sp)	! arg
	sc	#54
	cp	r0, #0xFFFF
	jr eq,	cerror
	ret

! ======================================================================
! int umask(mask) -- syscall #61
! ======================================================================
_umask:
	ld	r1, 2(sp)	! mask
	sc	#61
	ret
