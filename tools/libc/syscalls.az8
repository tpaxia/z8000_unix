! int stty(fd, buf) -- syscall #31
! ======================================================================
_stty:
	ld	r1, 2(sp)	! fd
	ld	r2, 4(sp)	! buf
	sc	#31
	cp	r0, #0xFFFF
	jr eq,	cerror
	ret

