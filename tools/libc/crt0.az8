! crt0.az8 - C runtime startup for Z8002 user programs (PCC/az8)
!
! Entry: exec() sets up user stack with:
!   @sp = argc
!   sp+2, sp+4, ... = argv[0], argv[1], ..., NULL, envp[], NULL
!
! Sets environ, calls main(argc, argv, envp), then exit(retval).

	.text
	.globl	_start
	.globl	_main
	.globl	_environ
	.globl	_edata
	.globl	_end
	.globl	__exit
	.globl	_exit

! --- Entry point (first instruction in text segment) ---
_start:
	! Zero BSS from _edata to _end
	lda	r8, _edata
	lda	r9, _end
	clr	r0
.Lbzloop:
	cp	r8, r9
	jr ge,	.Lbzdone
	ldb	@r8, rl0
	inc	r8, #1
	jr	.Lbzloop
.Lbzdone:
	! Set up args: argc at @sp, argv at sp+2
	ld	r1, @sp		! r1 = argc
	ld	r2, sp
	add	r2, #2		! r2 = argv = &sp[1]
	ld	r3, r1
	add	r3, r3		! argc * sizeof(char *)
	add	r3, r2
	add	r3, #2		! r3 = &argv[argc+1] = envp
	ld	_environ, r3
	sub	sp, #6		! allocate space for 3 args
	ld	4(sp), r3	! arg 3: envp
	ld	2(sp), r2	! arg 2: argv
	ld	0(sp), r1	! arg 1: argc
	call	_main
	! main() returned: exit(retval), which flushes stdio first
	ld	0(sp), r0	! arg 1: return value
	call	_exit
	halt

! --- _exit(status) --- syscall #1
__exit:
	ld	r1, 2(sp)	! status
	sc	#1
	halt			! should not return

! --- Startup owns environ; cerror owns errno in syscalls.az8 ---
	.bss
_environ: .zerow	1

! Keep address zero reserved in separate data space.
	.data
	.word	0
