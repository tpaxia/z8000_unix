! Stack recovery probes; forms from Z8000 CPU Technical Manual CALL/PUSH/INC.
	.text
	.globl _callgrow
	.globl _pushgrow
	.globl _rmwgrow
_callgrow:
	push @sp,r4
	ld r4,sp
	sub sp,#8192
	call .Lreturn
	ld sp,r4
	pop r4,@sp
	clr r0
	ret
.Lreturn:
	ret
_pushgrow:
	push @sp,r4
	ld r4,sp
	sub sp,#8192
	push @sp,#0x1234
	pop r0,@sp
	ld sp,r4
	pop r4,@sp
	ret
_rmwgrow:
	sub sp,#8192
	inc @sp,#1
	ld r1,#99
	sc #1
! CLR/CLRB IR, X and DA memory forms; manual CLR table, no flags changed.
	.globl _clrgrow
_clrgrow:
	push @sp,r4
	ld r4,sp
	ld r0,4(sp)
	sub sp,#8192
	cp r0,#0
	jr ne,.Lclrbyte
	clr @sp
	jr .Lclrcheck
.Lclrbyte:
	cp r0,#1
	jr ne,.Lclrindex
	clrb @sp
	jr .Lclrcheck
.Lclrindex:
	cp r0,#2
	jr ne,.Lclrindexb
	clr 0(sp)
	jr .Lclrcheck
.Lclrindexb:
	cp r0,#3
	jr ne,.Lclrdirect
	clrb 1(sp)
	jr .Lclrcheck
.Lclrdirect:
	ld sp,#0xc000
	cp r0,#4
	jr ne,.Lclrdirectb
	clr 0xc000
	jr .Lclrcheck
.Lclrdirectb:
	clrb 0xc001
.Lclrcheck:
	ld r0,@sp
	ld sp,r4
	pop r4,@sp
	ret
